<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- MLX_SERVER_PYTHON points at .venv-mlx, a dedicated in-repo venv
     (uv venv --python 3.14 .venv-mlx && uv pip install --python
     .venv-mlx/bin/python3 mlx-lm==0.31.3), not any other project's venv.
     A prior session had borrowed an unrelated project's venv for this,
     which cost real time to rediscover later - keep it self-contained. -->
<dict>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:{{HOME}}/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>MLX_SERVER_MODEL_PATH</key>
		<string>{{MLX_MODEL_PATH}}</string>
		<key>MLX_SERVER_PORT</key>
		<string>8080</string>
		<key>MLX_SERVER_PYTHON</key>
		<string>{{REPO_ROOT}}/.venv-mlx/bin/python3</string>
	</dict>
	<key>Label</key>
	<string>com.claude.pipeline.mlx-supervisor</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{REPO_ROOT}}/.venv-mlx/bin/python3</string>
		<string>{{REPO_ROOT}}/scripts/mlx_server_supervisor.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>{{REPO_ROOT}}/mlx-supervisor.err.log</string>
	<key>StandardOutPath</key>
	<string>{{REPO_ROOT}}/mlx-supervisor.log</string>
	<key>StartInterval</key>
	<integer>120</integer>
	<key>WorkingDirectory</key>
	<string>{{REPO_ROOT}}</string>
</dict>
</plist>

# .pipeline.env — operator overrides for the long-running pipeline processes
# (dashboard + scheduler). Copy to .pipeline.env in the repo root; it is
# gitignored and sourced with allexport by scripts/pipeline-env.sh, which both
# scripts/dashboard.sh and scripts/scheduler.sh source before dispatch.
#
# Sourcing order (see scripts/pipeline-env.sh): .pipeline.env is sourced
# FIRST, then .dashboard.env — so .dashboard.env keeps last-write precedence
# for keys it also sets (existing installs are unaffected), while keys set
# only here still reach both processes.

# --- Core paths -------------------------------------------------------------
# Where the pipeline reads/writes its plan files (JSON plans, manifests,
# notifications). Must exist; the scheduler and dashboard both resolve it.
#PLAN_DIR=/srv/pipeline/plans

# Root of the worktree the scheduler operates on when executing steps.
#WORKTREE_ROOT=/srv/pipeline/worktree

# --- Autonomy ---------------------------------------------------------------
# Scheduler autonomy level: "gated" (default; human approval gates) or a
# more permissive mode. Read by pipeline/config.py.
#PIPELINE_AUTONOMY=gated

# --- Provider routing -------------------------------------------------------
# Which backend handles chat and plan decomposition. "claude" uses the
# hosted model; "local" routes to the local model registry.
#PIPELINE_BACKEND_CHAT=claude
#PIPELINE_BACKEND_DECOMPOSE=claude

# Default model id used when a role has no explicit mapping.
#PIPELINE_LOCAL_MODEL_DEFAULT=devstral:24b

# Path to the model registry file mapping roles to providers/models.
#PIPELINE_MODEL_REGISTRY_PATH=/srv/pipeline/models/registry.json

# --- Notifications: plan_completed + outbound e-mail (opt-in) ---------------
# The pipeline can spool plan_completed notifications to a per-plan
# <plan>.outbox.jsonl outbox and deliver them as e-mail from the scheduler
# tick's drain phase. Both halves are disabled by default; see REFERENCE.md
# ("Notifications: plan_completed and the outbound e-mail channel") for the
# full semantics.
#
# Outbox spool:
# PIPELINE_NOTIFY_OUTBOX_ENABLED=false   # default: false — enables the per-plan <plan>.outbox.jsonl spool (only the exact string "1" enables it)
# PIPELINE_NOTIFY_OUTBOX_EVENTS=plan_completed   # default: plan_completed — comma-separated event allowlist applied when spooling
#
# E-mail channel (sent by the scheduler tick's drain phase; fails closed on
# a partial configuration):
# PIPELINE_NOTIFY_EMAIL_HOST=smtp.example.com   # default: unset — SMTP relay host; required for a send
# PIPELINE_NOTIFY_EMAIL_PORT=587   # default: 587 — SMTP submission port
# PIPELINE_NOTIFY_EMAIL_USERNAME=you@example.com   # default: unset — SMTP account name
#
# CREDENTIAL WARNING: PIPELINE_NOTIFY_EMAIL_PASSWORD is a credential — use a
# provider app-password, never a primary account password. .pipeline.env is
# gitignored and its values OVERRIDE the launchd plist and the ~/.claude.json
# MCP env block, so a value set here wins at runtime. Default: unset (empty) —
# the sender fails closed without it.
# PIPELINE_NOTIFY_EMAIL_PASSWORD=
# PIPELINE_NOTIFY_EMAIL_FROM=you@example.com   # default: unset — envelope From address; falls back to the username
# PIPELINE_NOTIFY_EMAIL_TO=you@example.com   # default: unset — recipient of the plan-completion e-mail
# PIPELINE_NOTIFY_EMAIL_SUBJECT=[pipeline] plan complete: <plan>   # default: "[pipeline] plan complete: <plan>" — subject line
# PIPELINE_NOTIFY_EMAIL_USE_TLS=true   # default: true — STARTTLS with mandatory certificate verification

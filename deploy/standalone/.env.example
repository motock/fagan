# Copy to deploy/standalone/.env and fill in. The installer writes generated
# values for the secret-looking entries; never commit .env (it is gitignored).
#
# The three required secrets -- KEYCLOAK_ADMIN_PASSWORD,
# PIPELINE_DASHBOARD_CLIENT_SECRET and PIPELINE_MCP_CLIENT_SECRET -- are
# deliberately blank. Compose reads them with `:?`, which fails closed on an
# unset or empty value, so `docker compose up` refuses to start until an operator
# fills them in. Every other value here is a non-secret default.

# ---- Public origin --------------------------------------------------------

# Name clients use to reach the stack. It appears in the certificate, the OIDC
# issuer and the MCP resource URL, so it must match what clients type.
PUBLIC_HOSTNAME=pipeline.example.internal

# Host port for the TLS front door. Caddy listens on 8443 inside the container.
PUBLIC_PORT=8443

# `internal` issues the certificate from Caddy's own CA (clients must trust
# that root). An email address switches Caddy to ACME for a public certificate.
CADDY_TLS=internal

# ---- Images ----------------------------------------------------------------

# Leave unset to build deploy/Dockerfile locally. Set to a published tag to skip
# the build, for example pipeline-standalone:1.0.0.
# PIPELINE_IMAGE=pipeline-standalone:local

# ---- Code hosts and models ----------------------------------------------------

# Comma-separated hosts the pipeline may clone from. Hosts only, no scheme.
PIPELINE_REPO_URL_HOSTS=github.com

# Ollama on the Docker host. host.docker.internal resolves to the host on
# Docker Desktop and, through host-gateway, on Linux.
OLLAMA_ENDPOINT=http://host.docker.internal:11434

# ---- Plan approval ----------------------------------------------------------

# Safety gates default on (ADR 0004). When on, an ingested plan does not
# dispatch until its owner or a delegate runs approve_plan. Set 0 to disable.
# Accepted values are those pipeline/plan_approval.py approval_enabled() takes:
# on/1/true (enabled), off/0/false (disabled) and empty (also disabled).
PIPELINE_PLAN_APPROVAL=1

# ---- Identity (Keycloak) -----------------------------------------------------

# Bootstrap admin for the Keycloak console. Created on first start only.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# OIDC audience the MCP tokens are minted for and the pipeline verifies.
PIPELINE_OIDC_AUDIENCE=pipeline-mcp

# Port the MCP CLI clients listen on for the OAuth callback. The realm
# pre-registers http://localhost:<port>/callback for them, so it must match the
# port the client uses.
PIPELINE_CLI_CALLBACK_PORT=8765

# Confidential client secrets. deploy/install.sh substitutes them into the realm
# template at install time and mounts the rendered copy into Keycloak, so a run
# through the installer needs no extra step. The dashboard secret must also be
# written to secrets/oidc_client_secret.
PIPELINE_DASHBOARD_CLIENT_SECRET=
PIPELINE_MCP_CLIENT_SECRET=

# Path to the rendered realm that compose mounts into Keycloak. `deploy/install.sh`
# renders the template to <state-dir>/import/realm.json and exports this variable
# before `docker compose up`, so an installer run does not need this line. When
# starting compose by hand, render the template first and point this at the
# result, otherwise compose refuses to start (`:?` guard). The rendered file holds
# the OIDC client secrets and is mode 0644 so that Keycloak (uid 1000 in the
# container) can read the bind-mounted copy, so render it into a directory only
# you can traverse -- the directory mode is what keeps the secrets private:
#   mkdir -p -m 0700 deploy/standalone/import
#   bash deploy/install.sh --render-realm deploy/standalone/realm.json deploy/standalone/import/realm.json
# Never copy import/realm.json out of that 0700 directory (backup, `docker cp`, `cp`).
STANDALONE_REALM_FILE=./import/realm.json

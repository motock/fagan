# Copy to deploy/standalone/.env and fill in. The installer writes generated
# values for the credential entries; never commit .env (it is gitignored).
#
# The credential entries below are deliberately *empty*. Compose refuses to
# start on an empty required value, so leaving them empty is what makes copy ->
# `compose up` fail closed. Do not paste a placeholder or an example value in
# their place: realm.json substitutes them verbatim at import, so any non-empty
# string here becomes a working credential. Generate each one (`openssl rand
# -hex 24`) and keep it out of git.

# ---- Public origin --------------------------------------------------------

# Name clients use to reach the stack. It appears in the certificate, the OIDC
# issuer and the MCP resource URL, so it must match what clients type.
PUBLIC_HOSTNAME=pipeline.example.internal

# Host port for the TLS front door. Caddy listens on 8443 inside the container.
PUBLIC_PORT=8443

# `internal` issues the certificate from Caddy's own CA (clients must trust
# that root). An email address switches Caddy to ACME for a public certificate.
CADDY_TLS=internal

# ---- Images ----------------------------------------------------------------

# Leave unset to build deploy/Dockerfile locally. Set to a published tag to skip
# the build, for example pipeline-standalone:1.0.0.
# PIPELINE_IMAGE=pipeline-standalone:local

# ---- Code hosts and models ----------------------------------------------------

# Comma-separated hosts the pipeline may clone from. Hosts only, no scheme.
PIPELINE_REPO_URL_HOSTS=github.com

# Ollama on the Docker host. host.docker.internal resolves to the host on
# Docker Desktop and, through host-gateway, on Linux.
OLLAMA_ENDPOINT=http://host.docker.internal:11434

# ---- Identity (Keycloak) -----------------------------------------------------

# Bootstrap admin for the Keycloak console. Created on first start only.
# Empty on purpose: compose's `:?` guard refuses to start until you generate it.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# OIDC audience the MCP tokens are minted for and the pipeline verifies.
PIPELINE_OIDC_AUDIENCE=pipeline-mcp

# Port the MCP CLI clients listen on for the OAuth callback. The realm
# pre-registers http://localhost:<port>/callback for them, so it must match the
# port the client uses.
PIPELINE_CLI_CALLBACK_PORT=8765

# Confidential client secrets, substituted into realm.json at import. Both are
# empty on purpose - compose's `:?` guard refuses to start until you generate
# them - because a non-empty placeholder here would become the live secret. The
# dashboard secret must also be written to secrets/oidc_client_secret.
PIPELINE_DASHBOARD_CLIENT_SECRET=
PIPELINE_MCP_CLIENT_SECRET=

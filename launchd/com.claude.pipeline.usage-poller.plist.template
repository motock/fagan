<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claude.pipeline.usage-poller</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{REPO_ROOT}}/.venv/bin/python3</string>
        <string>-c</string>
        <string>import pipeline_mcp_server as p; p.check_usage()</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{REPO_ROOT}}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{HOME}}/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{REPO_ROOT}}/usage-poller.log</string>

    <key>StandardErrorPath</key>
    <string>{{REPO_ROOT}}/usage-poller.err.log</string>
</dict>
</plist>
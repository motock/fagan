#!/usr/bin/env python3
"""Mint a short-lived MCP access token from a long-lived client credential.

For clients and scripts that cannot run a browser OAuth flow. The long-lived
secret is a per-user Keycloak client secret kept in a 0600 file; this helper
mints a fresh access token on every call and prints it.

  - default: a JSON object of headers, for Claude Code's MCP ``headersHelper``::

        {"Authorization": "Bearer <token>"}

  - ``--raw``: the bare token, for shell use::

        export PIPELINE_MCP_TOKEN=$(mcp-token --raw)

Config file: ``--config``, else ``PIPELINE_MCP_CREDENTIALS``, else
``~/.config/pipeline/mcp-client.json`` with keys ``token_url``, ``client_id``
and ``client_secret``. The file must not be group/other accessible.

Exit codes: 0 success, 2 configuration problem, 1 token/HTTP problem. Secrets
and response bodies are never printed or logged.
"""

from __future__ import annotations

import argparse
import base64
import http.client
import ipaddress
import json
import os
import ssl
import stat
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

DEFAULT_CONFIG_PATH = "~/.config/pipeline/mcp-client.json"
REQUIRED_KEYS = ("token_url", "client_id", "client_secret")
REQUEST_TIMEOUT = 8
MAX_RESPONSE_BYTES = 64 * 1024


class ConfigError(Exception):
    """The credentials file or its contents cannot be used."""


class TokenError(Exception):
    """The token endpoint was unreachable, refused, or answered unusably."""


def _is_loopback(host):
    """True only for hosts that cannot leave the machine."""
    if not host:
        return False
    if host == "localhost":
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


def _read_private_file(p):
    """Read the credentials file through a single fd, refusing symlinks and open modes."""
    unusable = f"config file not found or not a regular file: {p}"
    try:
        fd = os.open(p, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        raise ConfigError(unusable) from None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise ConfigError(unusable)
        mode = stat.S_IMODE(info.st_mode)
        if mode & 0o077:
            raise ConfigError(
                f"config file must not be group/other accessible (mode {oct(mode)}): {p}"
            )
        with os.fdopen(fd, "rb") as handle:
            fd = -1  # fdopen owns the descriptor now
            return handle.read()
    finally:
        if fd >= 0:
            os.close(fd)


def load_config(path, allow_insecure_http):
    """Read and validate the credentials file, returning its three keys."""
    p = Path(path).expanduser()
    raw = _read_private_file(p)

    try:
        data = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise ConfigError(f"config file is not valid JSON: {p}") from None
    if not isinstance(data, dict):
        raise ConfigError(f"config file must contain a JSON object: {p}")

    for key in REQUIRED_KEYS:
        value = data.get(key)
        if not isinstance(value, str) or not value.strip():
            raise ConfigError(f"config file is missing a non-empty {key}: {p}")

    parts = urllib.parse.urlsplit(data["token_url"])
    scheme = parts.scheme.lower()
    # --insecure-http exists for the tests only, so bind it to loopback: a single
    # flag must not be able to send the Basic credential in cleartext off-host.
    test_http = allow_insecure_http and scheme == "http" and _is_loopback(parts.hostname)
    if scheme != "https" and not test_http:
        raise ConfigError(
            f"token_url must be https (pass --insecure-http only for tests): {p}"
        )

    return {
        "token_url": data["token_url"],
        "client_id": data["client_id"],
        "client_secret": data["client_secret"],
    }


def _build_context(cacert):
    if cacert:
        try:
            return ssl.create_default_context(cafile=cacert)
        except OSError:
            raise TokenError(f"cannot load CA bundle: {cacert}") from None
    return ssl.create_default_context()


class _NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Refuse every 3xx.

    urllib would otherwise follow the redirect and resend the ``Authorization:
    Basic`` header -- the long-lived client secret -- to whatever host the token
    endpoint names, including across an https->http downgrade.
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise TokenError(f"token endpoint redirected (HTTP {code}); refusing to follow")


def _build_opener(context):
    """urllib's normal request stack, minus redirect following."""
    opener = urllib.request.OpenerDirector()
    for handler in (
        urllib.request.ProxyHandler(),
        urllib.request.UnknownHandler(),
        urllib.request.HTTPHandler(),
        urllib.request.HTTPSHandler(context=context),
        urllib.request.HTTPDefaultErrorHandler(),
        urllib.request.HTTPErrorProcessor(),
        _NoRedirectHandler(),
    ):
        opener.add_handler(handler)
    return opener


def fetch_token(config, cacert=None):
    """Request a client-credentials token and return just the token string."""
    context = _build_context(cacert)

    # RFC 6749 2.3.1: form-urlencode each half before Basic base64 encoding.
    user = urllib.parse.quote(config["client_id"], safe="")
    secret = urllib.parse.quote(config["client_secret"], safe="")
    basic = base64.b64encode(f"{user}:{secret}".encode()).decode()
    request = urllib.request.Request(
        config["token_url"],
        data=urllib.parse.urlencode({"grant_type": "client_credentials"}).encode(),
        headers={
            "Authorization": f"Basic {basic}",
            "Content-Type": "application/x-www-form-urlencoded",
            "Accept": "application/json",
        },
        method="POST",
    )

    try:
        with _build_opener(context).open(request, timeout=REQUEST_TIMEOUT) as response:
            payload = response.read(MAX_RESPONSE_BYTES + 1)
    except TokenError:
        raise
    except urllib.error.HTTPError as e:
        # Never read or print the body: some IdPs echo the client id/secret.
        raise TokenError(f"token endpoint returned HTTP {e.code}") from None
    except urllib.error.URLError:
        raise TokenError("token endpoint request failed") from None
    except http.client.HTTPException:
        # Truncated/garbled responses must still be one-line failures, not tracebacks.
        raise TokenError("token endpoint response was malformed") from None

    if len(payload) > MAX_RESPONSE_BYTES:
        raise TokenError("token endpoint response is too large")
    try:
        data = json.loads(payload.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise TokenError("token endpoint response is not valid JSON") from None
    if not isinstance(data, dict):
        raise TokenError("token endpoint response is not a JSON object")

    token = data.get("access_token")
    if not isinstance(token, str) or not token:
        raise TokenError("token endpoint response missing access_token")
    return token


def main(argv=None):
    """Run the helper; return 0 success, 2 config problem, 1 token problem."""
    parser = argparse.ArgumentParser(
        prog="mcp-token",
        description="Mint a short-lived MCP access token from a client credential.",
    )
    parser.add_argument(
        "--config",
        help="credentials file (default: $PIPELINE_MCP_CREDENTIALS or "
        f"{DEFAULT_CONFIG_PATH})",
    )
    parser.add_argument(
        "--raw",
        action="store_true",
        help="print only the bare token instead of a JSON headers object",
    )
    parser.add_argument(
        "--insecure-http",
        action="store_true",
        help="allow a plain http token_url (tests only)",
    )
    parser.add_argument("--cacert", help="CA bundle for the token endpoint (or $PIPELINE_MCP_CACERT)")
    args = parser.parse_args(argv)

    config_path = (
        args.config or os.environ.get("PIPELINE_MCP_CREDENTIALS") or DEFAULT_CONFIG_PATH
    )
    cacert = args.cacert or os.environ.get("PIPELINE_MCP_CACERT") or None

    try:
        config = load_config(config_path, args.insecure_http)
        token = fetch_token(config, cacert)
    except ConfigError as e:
        print(f"mcp-token: {e}", file=sys.stderr)
        return 2
    except TokenError as e:
        print(f"mcp-token: {e}", file=sys.stderr)
        return 1

    if args.raw:
        print(token)
    else:
        print(json.dumps({"Authorization": f"Bearer {token}"}))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

# Ignore files that are not part of the source code
.venv/
__pycache__/
.pytest_cache/
*.log
# Per-line timestamp sidecars written next to every dispatch/review log by
# pipeline/execution.py's spawn_local. "*.log" above does NOT match these.
*.log.ts
*.pyc
node_modules

# Dashboard start/stop script runtime artifacts (scripts/dashboard.sh)
.dashboard.*.pid
.scheduler.pid

# Dashboard HTTP API shared secret (app/auth.py) — never commit this.
.dashboard_api_key
# Operator-local dashboard env (sourced by scripts/dashboard.sh at start);
# copy .dashboard.env.example to .dashboard.env to activate.
.dashboard.env
# Operator-local pipeline env shared by scripts/dashboard.sh and
# scripts/scheduler.sh (sourced via scripts/pipeline-env.sh at start);
# copy .pipeline.env.example to .pipeline.env to activate.
.pipeline.env
.venv-mlx/
.DS_Store
*.bak
.tdd_split_test_author_done

# Local scratch/runtime state (not source)
.local/

# Operator's personal per-role model routing (provider/model chosen per
# role), selected via PIPELINE_MODEL_REGISTRY_PATH (app/role_registry.py's
# _registry_path) instead of the shipped provider-neutral model_registry.json.
model_registry.local.json

# Per-story agent working artifacts (never part of the source diff; see
# pipeline/paths.py's _WORKTREE_LOG_EXCLUDES). Untracking .agent_scratchpad.md
# fixed a bug where every dispatched agent wrote its own unrelated progress
# notes into this shared path and committed it, causing spurious merge-gate
# rebase conflicts between unrelated concurrent stories.

.agent_plan.md
.agent_scratchpad.md
.agent_scratchpad*.md
*agent_scratchpad*.md
.agent_transcript.json

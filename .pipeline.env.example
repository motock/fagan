# .pipeline.env — operator overrides for the long-running pipeline processes
# (dashboard + scheduler). Copy to .pipeline.env in the repo root; it is
# gitignored and sourced with allexport by scripts/pipeline-env.sh, which both
# scripts/dashboard.sh and scripts/scheduler.sh source before dispatch.
#
# Sourcing order (see scripts/pipeline-env.sh): .pipeline.env is sourced
# FIRST, then .dashboard.env — so .dashboard.env keeps last-write precedence
# for keys it also sets (existing installs are unaffected), while keys set
# only here still reach both processes.

# --- Core paths -------------------------------------------------------------
# Where the pipeline reads/writes its plan files (JSON plans, manifests,
# notifications). Must exist; the scheduler and dashboard both resolve it.
#PLAN_DIR=/srv/pipeline/plans

# Root of the worktree the scheduler operates on when executing steps.
#WORKTREE_ROOT=/srv/pipeline/worktree

# --- Autonomy ---------------------------------------------------------------
# Scheduler autonomy level: "gated" (default; human approval gates) or a
# more permissive mode. Read by pipeline/config.py.
#PIPELINE_AUTONOMY=gated

# --- Provider routing -------------------------------------------------------
# Which backend handles chat and plan decomposition. "claude" uses the
# hosted model; "local" routes to the local model registry.
#PIPELINE_BACKEND_CHAT=claude
#PIPELINE_BACKEND_DECOMPOSE=claude

# Default model id used when a role has no explicit mapping.
#PIPELINE_LOCAL_MODEL_DEFAULT=devstral:24b

# Path to the model registry file mapping roles to providers/models.
#PIPELINE_MODEL_REGISTRY_PATH=/srv/pipeline/models/registry.json